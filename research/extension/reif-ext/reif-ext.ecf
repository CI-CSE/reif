<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="reif-ext" uuid="677a7bee-a9b6-4a3c-b7ba-234b6ec8fe1b">
	<target name="bench" extends="bench" extends_location="$EIFFEL_SRC\Eiffel\Ace\ec.ecf">
		<capability>
			<concurrency support="thread"/>
		</capability>
		<cluster name="reif-ext-bench" location="extension" recursive="true">
			<file_rule>
				<exclude>batch/</exclude>
			</file_rule>
		</cluster>
	</target>
	<target name="batch" extends="batch" extends_location="$EIFFEL_SRC\Eiffel\Ace\ec.ecf">
		<root class="REIF_BATCH" feature="make"/>
		<cluster name="reif-ext-batch" location="extension" recursive="true">
			<file_rule>
				<exclude>bench/</exclude>
			</file_rule>
		</cluster>
		<cluster name="es_rota" location="$EIFFEL_SRC\Eiffel\API\framework\ecosystem\services\rota\" recursive="true">
			<file_rule>
				<exclude>ev_rota.e</exclude>
			</file_rule>
		</cluster>
	</target>
</system>
