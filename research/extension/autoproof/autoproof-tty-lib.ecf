<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="autoproof" uuid="010907b1-3c97-4f0d-97a5-ec394e0cdaf7" readonly="false" library_target="lib">
	<note>
		<eis src="http://www.gnu.org/licenses/gpl.html" tag="license" protocol="" name="GPL"/>
	</note>
	<description>
		AutoProof TTY extensions for EiffelStudio.
		This library can be included to add AutoProof features to EiffelStudio.

		To combine this extension with other extensions you might need to rename
		the EC_COMMAND_LINE_OPTION_EXTENSION class. See it for more details.

		Copyright (c) 2024 Constructor Institute of Technology
		Copyright (c) 2021-2022 Schaffhausen Institute of Technology
		Copyright (c) 2018-2019 Politecnico di Milano

		Author: Alexander Kogtenkov

		GNU General Public License (see https://www.gnu.org/licenses/)
	</description>
	<target name="lib">
		<capability>
			<concurrency support="none"/>
			<void_safety support="none"/>
		</capability>
		<root class="E2B_AUTOPROOF" feature="make"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="compiler" location="$EIFFEL_SRC\Eiffel\Ace\ec_kernel.ecf"/>
		<library name="time" location="$EIFFEL_SRC\library\time\time.ecf"/>
		<library name="configuration_parser" location="$EIFFEL_SRC\framework\configuration\configuration_parser.ecf"/>
		<library name="configuration_compiler" location="$EIFFEL_SRC\framework\configuration\configuration_compiler.ecf"/>
		<library name="parser" location="$EIFFEL_SRC\framework\parser\parser.ecf"/>
		<library name="patterns" location="$ISE_LIBRARY\library\patterns\patterns.ecf"/>
		<library name="program_analysis" location="$EIFFEL_SRC\framework\program_analysis\program_analysis.ecf"/>
		<library name="ecosystem" location="$EIFFEL_SRC\Eiffel\ecosystem\ecosystem.ecf"/>
		<library name="eiffel2boogie" location="$EIFFEL_SRC\..\research\extension\autoproof\framework\eiffel2boogie\eiffel2boogie.ecf"/>
		<library name="interface_names" location="$EIFFEL_SRC\framework\interface_names\interface_names.ecf"/>
		<cluster name="autoproof_extension" location="$EIFFEL_SRC\..\research\extension\autoproof\Eiffel\" recursive="true">
			<visible class="E_AUTOPROOF"/>
			<visible class="EC_COMMAND_LINE_OPTION_EXTENSION"/>
			<file_rule>
				<exclude>/interface/graphical</exclude>
			</file_rule>
		</cluster>
	</target>
</system>
