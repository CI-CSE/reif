<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="autoproof" uuid="4852CF34-4AE6-495F-9613-6D9297C0EF5D" readonly="false">
	<note>
		<eis src="http://www.gnu.org/licenses/gpl.html" tag="license" protocol="" name="GPL"/>
	</note>
	<description>
		EiffelStudio with AutoProof.

		Copyright (c) 2018-2019 Politecnico di Milano
		Copyright (c) 2021-2022 Schaffhausen Institute of Technology

		Author: Alexander Kogtenkov

		GNU General Public License (see https://www.gnu.org/licenses/)
	</description>
	<target name="bench" extends="bench" extends_location="autoproof-ext.ecf">
		<capability>
			<concurrency support="thread"/>
		</capability>
		<cluster name="ap-bench-initializer" location="service-initializers\" recursive="true">
			<visible class="ES_SERVICE_INITIALIZER_EXTENSION" feature="default_create"/>
			<visible class="SERVICE_INITIALIZER_EXTENSION" feature="add_core_services"/>
		</cluster>
	</target>
	<target name="batch" extends="batch" extends_location="autoproof-ext.ecf">
		<cluster name="ap-batch-initializer" location="service-initializers\" recursive="true">
			<file_rule>
				<exclude>bench</exclude>
			</file_rule>
			<visible class="BATCH_SERVICE_INITIALIZER_EXTENSION" feature="add_core_services"/>
		</cluster>
	</target>
</system>
